# ==============================================================================
# UptimeWatch Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment values.
# NEVER commit the active '.env' file containing real secrets to source control.

# Application Runtime Mode
# APP_ENV: 'development', 'staging', or 'production'
APP_ENV=development

# Simulation Mode:
# When 'true', bypasses live AWS API calls and uses local mock data.
# Note: In production (APP_ENV=production), SIMULATION_MODE MUST be 'false'.
SIMULATION_MODE=true

# AWS Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default
# Optional explicit credentials (prefer IAM roles on EC2):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS Resource Names & Namespaces
SSM_PARAM_PREFIX=/uptimewatch/prod
SQS_QUEUE_NAME=uptimewatch-checks-queue
SQS_DLQ_NAME=uptimewatch-checks-dlq
SNS_TOPIC_NAME=uptimewatch-alerts-topic
# S3_REPORTS_BUCKET=uptimewatch-reports-bucket-<YOUR_ACCOUNT_ID>

# Database Configuration (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uptimewatch
DB_USER=postgres
DB_PASSWORD=replace_with_secure_database_password
DB_URL=postgresql://postgres:replace_with_secure_database_password@localhost:5432/uptimewatch
